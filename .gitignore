# Model artifacts — trained models are regenerated, never committed.
# The repo ships WITHOUT any model so no private training data can leak.
models/*.joblib
models/*.json
models/*.zip
models/manifest.json
models/*.bin
!models/.gitkeep

# Local experiment scratch (private data must stay out of the repo)
scratch/
/tmp/

